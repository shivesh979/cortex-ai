PORT=8000

# Managed Redis (use Upstash in production)
REDIS_URL=redis://localhost:6379

# Internal service URLs (use Render private service names in production)
AUTH_SERVICE=http://auth:8001
CHAT_SERVICE=http://chat:8002
AGENT_SERVICE=http://agent:8003
BILLING_SERVICE=http://billing:8004

# Frontend URL for CORS (set to your Vercel URL in production)
FRONTEND_URL=http://localhost:5173

# MongoDB Atlas
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/billing

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
