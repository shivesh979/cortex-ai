PORT=8003
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/agent
# Redis for rate limiting + conversation memory (use Upstash in production)
REDIS_URL=redis://localhost:6379
GOOGLE_API_KEY=your_google_genai_key
GROQ_API_KEY=your_groq_key
TAVILY_API_KEY=your_tavily_key
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your-s3-bucket-name
OPENROUTER_API_KEY=your_openrouter_key
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key
# Internal service URLs (Render private service names in production)
CHAT_SERVICE=http://chat:8002
AUTH_SERVICE=http://auth:8001
GATEWAY_URL=http://gateway:8000
# Optional: override DNS servers used by this service (comma separated)
# CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1
