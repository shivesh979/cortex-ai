PORT=8001
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/auth
# Frontend URL for CORS (set to your Render frontend URL in production)
FRONTEND_URL=http://localhost:5173
# Redis for session store (use Upstash / Redis Cloud in production)
REDIS_URL=redis://localhost:6379
# Firebase Admin service account, full JSON as a single-line string
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# Optional: override DNS servers used by this service (comma separated)
# CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1
